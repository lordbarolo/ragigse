# Lovable Cloud / Supabase — publika nycklar (säkra att checka in).
# Riktiga värden injekteras automatiskt av Lovable i build/runtime.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_PROJECT_ID=your-project-id

# PostHog (valfri override — annars används default-EU-host via ph-proxy)
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# OBS: Privata nycklar (service role, API-secrets) lagras ALDRIG i .env.
# Använd Lovable Cloud Secrets för dem.
